# TLS termination + bảo vệ /hooks/* bằng header X-Reflex-Webhook-Token.
# Image nginx chạy envsubst lúc khởi động (chỉ thay biến env đã định nghĩa, nên $http_* giữ nguyên)
# và ghi ra /etc/nginx/nginx.conf (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx).
events {}

http {
  upstream control_plane { server control-plane:8090; }
  upstream console { server console:80; }

  server {
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location /hooks/ {
      # Allowlist IP webhook của Datadog, sinh bằng infra/compose/nginx/fetch-dd-webhook-ips.sh.
      # Không có file thì chỉ dựa vào token.
      include /etc/nginx/allow/*.conf;
      if ($http_x_reflex_webhook_token != "${REFLEX_WEBHOOK_TOKEN}") { return 401; }
      proxy_pass http://control_plane;
    }

    location /api/stream {
      proxy_pass http://control_plane;
      proxy_buffering off;
      proxy_read_timeout 1h;
    }

    location /api/ { proxy_pass http://control_plane; }
    location /     { proxy_pass http://console; }
  }
}
