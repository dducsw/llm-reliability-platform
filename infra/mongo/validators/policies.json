{
  "$jsonSchema": {
    "additionalProperties": false,
    "properties": {
      "_id": {
        "title": "Id",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "integer"
      },
      "candidates": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "target": {
              "title": "Target",
              "type": "string"
            },
            "weight": {
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Weight",
              "type": "number"
            },
            "role": {
              "enum": [
                "primary",
                "secondary",
                "brownout"
              ],
              "title": "CandidateRole",
              "type": "string"
            }
          },
          "required": [
            "target",
            "weight",
            "role"
          ],
          "title": "Candidate",
          "type": "object"
        },
        "title": "Candidates",
        "type": "array"
      },
      "scoring": {
        "additionalProperties": false,
        "properties": {
          "w_health": {
            "default": 0.35,
            "title": "W Health",
            "type": "number"
          },
          "w_budget": {
            "default": 0.25,
            "title": "W Budget",
            "type": "number"
          },
          "w_cost": {
            "default": 0.15,
            "title": "W Cost",
            "type": "number"
          },
          "w_quality": {
            "default": 0.2,
            "title": "W Quality",
            "type": "number"
          },
          "w_capacity": {
            "default": 0.05,
            "title": "W Capacity",
            "type": "number"
          },
          "temperature": {
            "default": 0.15,
            "title": "Temperature",
            "type": "number"
          }
        },
        "title": "Scoring",
        "type": "object",
        "default": {
          "w_health": 0.35,
          "w_budget": 0.25,
          "w_cost": 0.15,
          "w_quality": 0.2,
          "w_capacity": 0.05,
          "temperature": 0.15
        }
      },
      "breaker": {
        "additionalProperties": false,
        "properties": {
          "window_s": {
            "default": 20,
            "title": "Window S",
            "type": "integer"
          },
          "min_requests": {
            "default": 20,
            "title": "Min Requests",
            "type": "integer"
          },
          "open_error_ratio": {
            "default": 0.5,
            "title": "Open Error Ratio",
            "type": "number"
          },
          "open_base_s": {
            "default": 10,
            "title": "Open Base S",
            "type": "integer"
          },
          "open_max_s": {
            "default": 120,
            "title": "Open Max S",
            "type": "integer"
          },
          "half_open_probes": {
            "default": 3,
            "title": "Half Open Probes",
            "type": "integer"
          }
        },
        "title": "BreakerConfig",
        "type": "object",
        "default": {
          "window_s": 20,
          "min_requests": 20,
          "open_error_ratio": 0.5,
          "open_base_s": 10,
          "open_max_s": 120,
          "half_open_probes": 3
        }
      },
      "retry": {
        "additionalProperties": false,
        "properties": {
          "max_attempts": {
            "default": 3,
            "title": "Max Attempts",
            "type": "integer"
          },
          "budget_ratio": {
            "default": 0.1,
            "title": "Budget Ratio",
            "type": "number"
          },
          "on": {
            "default": [
              "5xx",
              "timeout",
              "rate_limited"
            ],
            "items": {
              "type": "string"
            },
            "title": "On",
            "type": "array"
          },
          "respect_retry_after": {
            "default": true,
            "title": "Respect Retry After",
            "type": "boolean"
          }
        },
        "title": "RetryConfig",
        "type": "object",
        "default": {
          "max_attempts": 3,
          "budget_ratio": 0.1,
          "on": [
            "5xx",
            "timeout",
            "rate_limited"
          ],
          "respect_retry_after": true
        }
      },
      "rescue": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "on": {
            "default": [
              "quality"
            ],
            "items": {
              "type": "string"
            },
            "title": "On",
            "type": "array"
          },
          "cross_target_only": {
            "default": true,
            "title": "Cross Target Only",
            "type": "boolean"
          },
          "max_extra_cost_ratio": {
            "default": 0.6,
            "title": "Max Extra Cost Ratio",
            "type": "number"
          }
        },
        "title": "RescueConfig",
        "type": "object",
        "default": {
          "enabled": true,
          "on": [
            "quality"
          ],
          "cross_target_only": true,
          "max_extra_cost_ratio": 0.6
        }
      },
      "hedge": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "after": {
            "default": "p95_ttft",
            "title": "After",
            "type": "string"
          },
          "max_extra_cost_ratio": {
            "default": 0.05,
            "title": "Max Extra Cost Ratio",
            "type": "number"
          }
        },
        "title": "HedgeConfig",
        "type": "object",
        "default": {
          "enabled": false,
          "after": "p95_ttft",
          "max_extra_cost_ratio": 0.05
        }
      },
      "validators": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Validators",
        "type": "array"
      },
      "deadline_ms": {
        "default": 8000,
        "title": "Deadline Ms",
        "type": "integer"
      },
      "shed": {
        "additionalProperties": false,
        "properties": {
          "when_all_degraded_min_priority": {
            "default": 1,
            "title": "When All Degraded Min Priority",
            "type": "integer"
          }
        },
        "title": "ShedConfig",
        "type": "object",
        "default": {
          "when_all_degraded_min_priority": 1
        }
      },
      "updated_by": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "actor": {
                "title": "Actor",
                "type": "string"
              },
              "action_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Action Id"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reason"
              }
            },
            "required": [
              "actor"
            ],
            "title": "UpdatedBy",
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Updated At"
      }
    },
    "required": [
      "_id",
      "version",
      "candidates"
    ],
    "title": "Policy",
    "type": "object"
  }
}