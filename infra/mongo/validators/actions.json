{
  "$jsonSchema": {
    "additionalProperties": false,
    "properties": {
      "_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Id"
      },
      "incident_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incident Id"
      },
      "parent_action_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Action Id"
      },
      "type": {
        "enum": [
          "shift_weight",
          "open_circuit_global",
          "enable_hedging",
          "set_concurrency",
          "shed_priority",
          "downgrade_tier",
          "failback_step",
          "rollback_flag",
          "page_human"
        ],
        "title": "ActionType",
        "type": "string"
      },
      "params": {
        "additionalProperties": true,
        "title": "Params",
        "type": "object"
      },
      "state": {
        "enum": [
          "proposed",
          "approved",
          "awaiting_approval",
          "rejected",
          "executing",
          "verifying",
          "succeeded",
          "failed",
          "rolled_back"
        ],
        "title": "ActionState",
        "type": "string",
        "default": "proposed"
      },
      "proposed_by": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "investigation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Investigation Id"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          }
        },
        "required": [
          "actor"
        ],
        "title": "ProposedBy",
        "type": "object"
      },
      "decision": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Mode",
                "type": "string"
              },
              "by": {
                "title": "By",
                "type": "string"
              },
              "at": {
                "format": "date-time",
                "title": "At",
                "type": "string"
              },
              "guardrails": {
                "default": [],
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "title": "Name",
                      "type": "string"
                    },
                    "pass": {
                      "title": "Pass",
                      "type": "boolean"
                    },
                    "detail": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Detail"
                    }
                  },
                  "required": [
                    "name",
                    "pass"
                  ],
                  "title": "GuardrailResult",
                  "type": "object"
                },
                "title": "Guardrails",
                "type": "array"
              }
            },
            "required": [
              "mode",
              "by",
              "at"
            ],
            "title": "Decision",
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "execution": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "policy_id": {
                "title": "Policy Id",
                "type": "string"
              },
              "version_before": {
                "title": "Version Before",
                "type": "integer"
              },
              "version_after": {
                "title": "Version After",
                "type": "integer"
              },
              "applied_at": {
                "format": "date-time",
                "title": "Applied At",
                "type": "string"
              }
            },
            "required": [
              "policy_id",
              "version_before",
              "version_after",
              "applied_at"
            ],
            "title": "Execution",
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "verification": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "window": {
                "additionalProperties": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "format": "date-time",
                      "type": "string"
                    },
                    {
                      "format": "date-time",
                      "type": "string"
                    }
                  ],
                  "type": "array"
                },
                "title": "Window",
                "type": "object"
              },
              "metric": {
                "title": "Metric",
                "type": "string"
              },
              "baseline": {
                "additionalProperties": false,
                "properties": {
                  "good": {
                    "title": "Good",
                    "type": "integer"
                  },
                  "n": {
                    "title": "N",
                    "type": "integer"
                  }
                },
                "required": [
                  "good",
                  "n"
                ],
                "title": "Proportion",
                "type": "object"
              },
              "after": {
                "additionalProperties": false,
                "properties": {
                  "good": {
                    "title": "Good",
                    "type": "integer"
                  },
                  "n": {
                    "title": "N",
                    "type": "integer"
                  }
                },
                "required": [
                  "good",
                  "n"
                ],
                "title": "Proportion",
                "type": "object"
              },
              "method": {
                "default": "wilson+two_proportion",
                "title": "Method",
                "type": "string"
              },
              "after_ci": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "title": "After Ci",
                "type": "array"
              },
              "p_value": {
                "title": "P Value",
                "type": "number"
              },
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE"
                ],
                "title": "Verdict",
                "type": "string"
              },
              "decided_at": {
                "format": "date-time",
                "title": "Decided At",
                "type": "string"
              }
            },
            "required": [
              "window",
              "metric",
              "baseline",
              "after",
              "after_ci",
              "p_value",
              "verdict",
              "decided_at"
            ],
            "title": "VerificationResult",
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "ttr_s": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ttr S"
      },
      "created_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Created At"
      },
      "updated_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Updated At"
      }
    },
    "required": [
      "type",
      "params",
      "proposed_by"
    ],
    "title": "Action",
    "type": "object"
  }
}