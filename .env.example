# ---- Môi trường -------------------------------------------------------------
REFLEX_ENV=local                 # local | ci | demo
REFLEX_PROFILE=demo              # demo | standard (SLO time scale)
REFLEX_VERSION=                  # mặc định đọc từ file VERSION

# ---- MongoDB ----------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=reflex

# ---- Datadog ----------------------------------------------------------------
DD_API_KEY=
DD_APP_KEY=                      # Cortex: scope đọc (logs/apm/metrics/monitors) + events write
DD_SITE=
DD_AGENT_HOST=datadog-agent
DD_TRACE_ENABLED=true
DD_LLMOBS_ENABLED=true
DD_LLMOBS_ML_APP=reflex-cortex

# ---- LLM vendors (đặt ở chaos-proxy; gateway không giữ key) ------------------
VENDOR_A_API_KEY=
VENDOR_A_BASE_URL=
VENDOR_A_LARGE_MODEL=
VENDOR_A_SMALL_MODEL=
VENDOR_B_API_KEY=
VENDOR_B_BASE_URL=
VENDOR_B_LARGE_MODEL=
ANTHROPIC_API_KEY=               # Cortex gọi qua gateway, route cortex.reason
# Vendor thật cho chaos-proxy (OpenAI-compatible). Chỉ route trong LLM_REAL_ROUTES gọi thật;
# còn lại vẫn mock (load test không đốt token). Trống key → toàn bộ mock.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_REAL_ROUTES=cortex.reason

# ---- Service URLs -----------------------------------------------------------
GATEWAY_URL=http://gateway-1:8080
CONTROL_PLANE_URL=http://control-plane:8090
CHAOS_PROXY_URL=http://chaos-proxy:8070
MOCK_LLM_URL=http://mock-llm:8060

# ---- Security ---------------------------------------------------------------
REFLEX_WEBHOOK_TOKEN=            # Datadog webhook header X-Reflex-Webhook-Token
REFLEX_WEBHOOK_URL=                # URL công khai tới control-plane /hooks/datadog (ngrok/nginx TLS)
REFLEX_CONSOLE_TOKEN=
REFLEX_LAB_TOKEN=
